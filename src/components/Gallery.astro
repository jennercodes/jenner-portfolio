---
/**
 * Grilla de capturas del caso, con PhotoSwipe al hacer clic.
 * Sin JS cada miniatura enlaza a la imagen completa.
 */

import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { src: ImageMetadata; alt: string }[];
}

const { items } = Astro.props;
const images = await Promise.all(
  items.map(async (item) => ({
    ...item,
    full: await getImage({ src: item.src, format: 'webp', width: Math.min(item.src.width, 2400) }),
  })),
);
---

<div class="flex flex-col gap-3">
  <h2 class="font-mono text-xs tracking-[0.16em] text-muted uppercase">Capturas</h2>
  <ul data-gallery class="grid grid-cols-2 gap-2">
    {
      images.map(({ src, alt, full }) => (
        <li>
          <a
            href={full.src}
            data-pswp-width={full.attributes.width}
            data-pswp-height={full.attributes.height}
            class="group block aspect-[4/3] overflow-hidden rounded-md border border-line bg-surface focus-visible:outline-2 focus-visible:outline-accent"
          >
            <Image
              src={src}
              alt={alt}
              widths={[160, 320]}
              sizes="(min-width: 1024px) 136px, 45vw"
              class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none"
            />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: 'a',
      pswpModule: () => import('photoswipe'),
      showHideAnimationType: reduce ? 'none' : 'zoom',
      bgOpacity: 0.92,
      closeTitle: 'Cerrar',
      zoomTitle: 'Acercar',
      arrowPrevTitle: 'Anterior',
      arrowNextTitle: 'Siguiente',
      errorMsg: 'No se pudo cargar la imagen.',
    });
    // La descripción de cada captura, para lectores de pantalla y como pie
    lightbox.addFilter('itemData', (data, index) => {
      const img = gallery.querySelectorAll('img')[index];
      return { ...data, alt: img?.alt ?? '' };
    });
    lightbox.init();
  }
</script>
