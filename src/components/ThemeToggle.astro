---
/**
 * Botón de tema: sistema → claro → oscuro. La preferencia se guarda en localStorage
 * y el script inline de Base.astro la aplica antes de pintar.
 */
---

<button
  type="button"
  data-theme-toggle
  data-mode="system"
  data-magnetic
  aria-label="Tema: sistema"
  title="Tema: sistema"
  class="group inline-flex size-9 items-center justify-center rounded-lg border border-subtle bg-surface text-muted transition-colors hover:border-muted hover:text-fg"
>
  <svg class="hidden size-4 group-data-[mode=system]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="4" width="18" height="12" rx="2" />
    <path d="M8 20h8M12 16v4" />
  </svg>
  <svg class="hidden size-4 group-data-[mode=light]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="hidden size-4 group-data-[mode=dark]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
  </svg>
</button>

<script>
  type Mode = 'system' | 'light' | 'dark';

  const order: Mode[] = ['system', 'light', 'dark'];
  const labels: Record<Mode, string> = { system: 'sistema', light: 'claro', dark: 'oscuro' };
  const themeColor = { light: '#fafafa', dark: '#09090b' };

  function current(): Mode {
    const t = document.documentElement.dataset.theme;
    return t === 'light' || t === 'dark' ? t : 'system';
  }

  function apply(mode: Mode) {
    const root = document.documentElement;
    if (mode === 'system') delete root.dataset.theme;
    else root.dataset.theme = mode;

    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
      const scheme = meta.media.includes('dark') ? 'dark' : 'light';
      meta.content = themeColor[mode === 'system' ? scheme : mode];
    }

    try {
      if (mode === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', mode);
    } catch {}
  }

  function render(button: HTMLButtonElement, mode: Mode) {
    const label = `Tema: ${labels[mode]}`;
    button.dataset.mode = mode;
    button.setAttribute('aria-label', label);
    button.title = label;
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    render(button, current());
    button.addEventListener('click', () => {
      const next = order[(order.indexOf(current()) + 1) % order.length];
      apply(next);
      render(button, next);
    });
  }
</script>
