---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" noindex>
  <section class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-24 sm:px-8 sm:py-32">
    <p class="font-mono text-sm text-muted"><span class="text-accent">$</span> cd {Astro.url.pathname}</p>
    <p class="font-mono text-sm text-muted">No such file or directory</p>
    <h1 data-split class="text-5xl font-semibold tracking-[-0.04em] sm:text-7xl">Esta página no existe.</h1>
    <a
      href="/"
      class="mt-4 inline-flex h-13 items-center rounded-xl bg-btn-bg px-6 font-semibold text-btn-fg transition-opacity hover:opacity-90"
    >
      Volver al inicio
    </a>
  </section>
</Base>
